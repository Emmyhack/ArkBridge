{
  "name": "@arkbridge/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Transfer history and message status. A read model — never trusted for asset authorisation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arkbridge/bridge-core": "workspace:*",
    "@arkbridge/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
