{
  "name": "@arkbridge/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-package tests for the ArkBridge registries and configuration layer.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@arkbridge/chain-registry": "workspace:*",
    "@arkbridge/config": "workspace:*",
    "@arkbridge/token-registry": "workspace:*",
    "@arkbridge/types": "workspace:*",
    "@arkbridge/bridge-core": "workspace:*",
    "@arkbridge/indexer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  }
}
