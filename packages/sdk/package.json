{
  "name": "@arkbridge/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "The integration surface for ArkBridge. Never handles private keys.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arkbridge/bridge-core": "workspace:*",
    "@arkbridge/chain-registry": "workspace:*",
    "@arkbridge/config": "workspace:*",
    "@arkbridge/token-registry": "workspace:*",
    "@arkbridge/types": "workspace:*",
    "viem": "^2.40.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.20.0"
  }
}
