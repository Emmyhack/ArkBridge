# syntax=docker/dockerfile:1

# ArkBridge web, production image.
#
# Three stages so the shipped image contains the server and nothing else: no
# pnpm, no toolchain, no workspace sources, no private keys.
#
# WHAT THIS IMAGE NEEDS AT RUNTIME THAT A NORMAL NEXT APP DOES NOT
#
# Contract addresses are read from `deployments/<environment>/*.json` on the
# server, on request, rather than baked into the bundle (§120, §154: a
# redeployed contract must not require a frontend rebuild). So the artifacts are
# copied in, and ARKBRIDGE_REPO_ROOT points at them — inside a container there
# is no workspace to walk up to.

# ----------------------------------------------------------------------- build
#
# Install and build in ONE stage.
#
# The obvious split — a `deps` stage that installs, a `build` stage that copies
# `node_modules` across — does not work with pnpm workspaces. pnpm gives every
# workspace package its own `node_modules` full of symlinks into the store, so
# `packages/ui/node_modules/react` is where the ui package finds React. Copying
# only the root and app trees leaves those behind, and the build fails with
# `Cannot find module 'react'` in a package that plainly depends on it.
#
# Layer caching is preserved the other way: manifests are copied first and the
# install is cached against them, so editing source does not reinstall.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /repo

# Manifests only — this layer rebuilds when dependencies change, not on source
# edits.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY packages/bridge-core/package.json packages/bridge-core/
COPY packages/chain-registry/package.json packages/chain-registry/
COPY packages/config/package.json packages/config/
COPY packages/indexer/package.json packages/indexer/
COPY packages/sdk/package.json packages/sdk/
COPY packages/token-registry/package.json packages/token-registry/
COPY packages/types/package.json packages/types/
COPY packages/ui/package.json packages/ui/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile --filter @arkbridge/web...

# `node_modules` is in .dockerignore, so this does not clobber the install.
COPY . .

# The workspace packages are TypeScript and the app resolves their build
# outputs, so they are built first. `...` builds dependencies too.
RUN pnpm --filter @arkbridge/web... build

# --------------------------------------------------------------------- runtime
FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Never run the server as root.
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs

# `standalone` already contains the traced server and its dependencies. Static
# assets and `public/` are not traced and must be copied alongside it.
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /repo/apps/web/.next/static ./apps/web/.next/static
# No `public/` directory: every asset this app serves is either imported through
# the bundler or generated by a route (`app/icon.svg`). A COPY of a path that
# does not exist fails the build, so there is nothing to copy here.

# The contract addresses. Read on request, so they are data in the image rather
# than constants in the bundle — a redeploy replaces this directory, not the app.
COPY --from=build --chown=nextjs:nodejs /repo/deployments ./deployments
ENV ARKBRIDGE_REPO_ROOT=/app

USER nextjs
EXPOSE 3000

# Fails the container when the app stops serving, rather than leaving a healthy
# looking container that returns errors.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/bridge').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/web/server.js"]
