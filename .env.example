# =============================================================================
# ArkBridge environment template
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit `.env` — it is gitignored (.gitignore:21).
# NEVER expose any *_PRIVATE_KEY / *_KEY value to the frontend. Only variables
# prefixed with NEXT_PUBLIC_ are bundled into apps/web.
#
# Every RPC endpoint below was verified live with `pnpm check:chains`.
# Re-run it after changing any of them.
# =============================================================================

# ---------------------------------------------------------------------------
# Environment selector: local | testnet | staging | mainnet
# ---------------------------------------------------------------------------
ARKBRIDGE_ENV=testnet

# ---------------------------------------------------------------------------
# Ark Constellation Devnet
# ---------------------------------------------------------------------------
# Ark is a Cosmos SDK chain with an EVM execution layer. ArkBridge uses the EVM
# JSON-RPC endpoint only; the CometBFT RPC and LCD are operational surfaces.
#
# Ark has two identifiers for the same network:
#   Cosmos chain id  arkdevnet_9000-1
#   EVM chain id     9000              <- this is what ARK_CHAIN_ID means
#
# Verified live: eth_chainId returns 0x2328 (9000).
ARK_RPC_URL=https://evm.34.60.137.196.sslip.io
ARK_WS_URL=wss://evm-ws.34.60.137.196.sslip.io
ARK_CHAIN_ID=9000

# PENDING — Build Phase 2. This is a third, unrelated identifier, and unlike the
# EVM chain id it is not a value to look up: Ark has no Hyperlane core yet, so
# the domain does not exist until ArkBridge deploys the Mailbox and picks one.
#
# It must be globally unique across Hyperlane. The convention of reusing the EVM
# chain id would make it 9000 — check @hyperlane-xyz/registry before committing
# to that. Once deployed it is fixed in bytecode and trusted by every remote
# router; changing it later means redeploying and re-enrolling every route.
#
# After deployment, read the deployed value back rather than trusting the plan:
#   cast call $MAILBOX "localDomain()(uint32)" --rpc-url $ARK_RPC_URL
ARK_HYPERLANE_DOMAIN_ID=

ARK_EXPLORER_URL=https://explorer.34.60.137.196.sslip.io
ARK_EXPLORER_API_URL=https://explorer-api.34.60.137.196.sslip.io
ARK_FAUCET_URL=https://faucet.34.60.137.196.sslip.io/

# Cosmos-layer endpoints. Not used by the bridge; listed for operations.
ARK_COSMOS_RPC_URL=https://rpc.34.60.137.196.sslip.io
ARK_COSMOS_LCD_URL=https://lcd.34.60.137.196.sslip.io

# These sslip.io hostnames are devnet-only and must move to an Ark-owned domain
# before a public testnet. The legacy plaintext endpoints on the raw IP
# (http://34.60.137.196:8545 and friends) are deliberately not used: bridge
# tooling should not fall back to an unauthenticated transport.

# ---------------------------------------------------------------------------
# Ethereum
# ---------------------------------------------------------------------------
# Unauthenticated public endpoints, fine for development. Production traffic
# should run through a dedicated provider — swap these for your own URL.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ---------------------------------------------------------------------------
# BNB Smart Chain
# ---------------------------------------------------------------------------
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# ---------------------------------------------------------------------------
# Deployment key (server-side only)
# ---------------------------------------------------------------------------
# A secp256k1 private key is exactly 64 hex characters after the 0x prefix.
# Generate one with:  cast wallet new
# Check what you have:  echo -n "${DEPLOYER_PRIVATE_KEY#0x}" | wc -c   -> 64
# Then fund it from the Ark faucet above, and on Sepolia / BSC Testnet.
#
# Mainnet is different: a deployer must not retain admin authority. Critical
# roles go to a multisig — see docs/security/invariants.md and SECURITY.md.
DEPLOYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# BSC Testnet deployer (server-side only)
# ---------------------------------------------------------------------------
# Separate from DEPLOYER_PRIVATE_KEY on purpose. That key owns every ownable
# contract in the Ark core deployment (Mailbox, domainRoutingIsm, protocolFee,
# proxyAdmin, interchainAccountRouter) and must not be replaced.
#
# Address: 0x3f2704f48c1712072C734943BE5d68173B2B9B34
#
# ⚠ This key was pasted into a chat transcript and must be treated as public.
#   It is acceptable for a testnet wallet holding only faucet funds. Do not
#   reuse it on mainnet, and do not fund it with anything of value.
BSC_DEPLOYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Base Sepolia deployer (server-side only)
# ---------------------------------------------------------------------------
# Address: 0x340eb86C6FfE6341fC8Ecb9fdFb5f92b098cc03C
#
# Supplementary. Base Sepolia was already deployed and round-tripped using
# DEPLOYER_PRIVATE_KEY (0xF031...6420), which owns the ISM, MockUSDC and warp
# router there. This key owns nothing on Base yet — it is spare gas, not a
# replacement.
#
# WARNING: pasted into a chat transcript, so treat it as public. Fine for a
# testnet wallet holding faucet funds. Never reuse on mainnet.
BASE_DEPLOYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Agent keys (server-side only) — Build Phase 3
# ---------------------------------------------------------------------------
# Generate each separately with `cast wallet new`. Every validator MUST use a
# distinct key: reusing one across validators collapses a 2-of-3 multisig ISM
# into a 1-of-1, which is the whole security model gone.
#
# The relayer needs native gas on Ark, Sepolia and BSC Testnet. It delivers
# messages; it does not authorise them, so it is not a security authority.
RELAYER_KEY=

VALIDATOR_1_KEY=
VALIDATOR_2_KEY=
VALIDATOR_3_KEY=

# ---------------------------------------------------------------------------
# Block explorer verification
# ---------------------------------------------------------------------------
# Etherscan v2 uses one key across chains: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
# https://bscscan.com/myapikey
BSCSCAN_API_KEY=
# Ark runs Blockscout, which accepts verification without a key on the devnet.
# Leave empty; foundry.toml passes it through either way.
ARK_EXPLORER_API_KEY=

# ---------------------------------------------------------------------------
# Indexer — Build Phase 8
# ---------------------------------------------------------------------------
# Local default; not needed until the indexer exists. Stores no private keys.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Frontend — Build Phase 9
# ---------------------------------------------------------------------------
# PUBLIC: everything below is bundled into the browser. No secrets here, ever.
NEXT_PUBLIC_ARKBRIDGE_ENV=testnet
# https://dashboard.reown.com — needed for WalletConnect-compatible wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_INDEXER_URL=http://localhost:4000
